# Copia questo file in .env e compila i valori. Il file .env non va mai versionato.

# Solax Developer Portal (developer.solaxcloud.com): crea un'applicazione,
# poi copia Client ID e Client Secret dalla scheda Authorization
SOLAX_APP_CODE=
SOLAX_CLIENT_ID=
SOLAX_CLIENT_SECRET=

# Octopus Energy Italia: le stesse credenziali dell'app
OCTOPUS_EMAIL=
OCTOPUS_PASSWORD=

# Tesla Fleet API (developer.tesla.com): Client ID e Client Secret dell'applicazione
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=

# Password di accesso alla webapp
WEB_PASSWORD=

# Con true i comandi vengono inviati davvero all'auto
LIVE=

# Emmeti AQ-IoT (emmeti.aq-iot.net): le credenziali con cui accedi al portale della pompa di calore
EMMETI_USERNAME=
EMMETI_PASSWORD=
# Nomi delle stanze, per indirizzo del termostato: 11:Salotto,12:Camera
ROOM_NAMES=
# Ore in cui di solito l'auto è a casa, per giorno (lunedì = 0): 0:9-18;2:14-19
HOME_PLAN=
