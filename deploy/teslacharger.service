[Unit]
Description=TeslaCharger: ciclo di controllo e webapp
After=network-online.target teslacharger-proxy.service
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/teslacharger/app
ExecStart=/usr/bin/python3.13 -m teslacharger.app
Restart=on-failure
RestartSec=15
MemoryMax=120M

[Install]
WantedBy=multi-user.target
