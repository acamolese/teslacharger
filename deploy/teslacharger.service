[Unit]
Description=TeslaCharger: ciclo di controllo e webapp
After=network-online.target teslacharger-proxy.service
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/teslacharger/app
ExecStart=/home/ubuntu/teslacharger/venv/bin/python -m teslacharger.app
Restart=on-failure
RestartSec=15
MemoryMax=120M

[Install]
WantedBy=multi-user.target
